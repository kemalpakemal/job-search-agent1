# Обязательно задай собственный длинный пароль перед публикацией приложения.
APP_PASSWORD=change-this-to-a-long-random-password

# Постоянное хранилище. Для Railway подключи Volume к /data.
DATABASE_URL=sqlite:////data/job_agent.db

TARGET_CITY=Сочи
TRUDVSEM_REGION_CODE=23
MIN_NET_SALARY=60000
SEARCH_INTERVAL_HOURS=12

# HeadHunter просит User-Agent с названием приложения и контактным email.
HH_USER_AGENT=JobSearchAgent/1.0 (your-contact-email@example.com)

# SuperJob: API App ID из кабинета разработчика. Без ключа поиск пропускается.
SUPERJOB_APP_ID=

# Telegram Bot API: создай бота через @BotFather. После запуска отправь ему /id, затем добавь свой ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# Необязательная AI-генерация писем через OpenAI-совместимый Chat Completions API.
# Это может тарифицироваться отдельно выбранным провайдером.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
