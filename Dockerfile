FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY source.zip /tmp/source.zip
RUN python -c "import zipfile; zipfile.ZipFile('/tmp/source.zip').extractall('/app')" \
    && pip install --no-cache-dir -r /app/requirements.txt \
    && mkdir -p /data
COPY scoring.py /app/scoring.py
COPY connectors.py /app/connectors.py
COPY main.py /app/main.py
COPY telegram_bot.py /app/telegram_bot.py
RUN python -m py_compile /app/main.py /app/connectors.py /app/scoring.py /app/telegram_bot.py \
    && python -c "from scoring import score_vacancy, is_profile_relevant, has_training_offer, has_experience_conflict, required_software_conflicts; exact={'title':'Бухгалтер по зарплате','city':'Сочи'}; unrelated={'title':'Бухгалтер-эксперт','city':'Сочи','description':'Расчёт себестоимости, дебиторская задолженность, акты сверки'}; training={'title':'Ведущий бухгалтер по расчёту заработной платы','city':'Сочи','description':'Расчёт зарплаты, больничные, отпускные. Обучим сами, опыт не требуется'}; assert score_vacancy(exact)[0] >= 80; assert not is_profile_relevant(unrelated); assert is_profile_relevant(training); assert has_training_offer(training['description']); assert not has_experience_conflict('От 5 лет опыта, но обучим сами'); assert len(required_software_conflicts('Знание 1С ЗГУ, Парус, Веб исполнение бюджета')) == 3; assert not required_software_conflicts('Знание 1С ЗГУ, Парус, Веб исполнение бюджета, обучим сами'); vacancy_with_software_gaps={'title':'Бухгалтер по учёту заработной платы','city':'Сочи','schedule':'5/2','description':'Начисление заработной платы, отпускные, больничные, командировки, табели. Требования: знание 1С:ЗГУ, Парус, Веб-исполнение бюджета. Зарплата: 65 000 ₽ на руки.'}; software_score, software_reasons=score_vacancy(vacancy_with_software_gaps); assert 60 <= software_score <= 85; assert any('Снижение оценки' in reason for reason in software_reasons); from connectors import VacancyConnectors; assert callable(getattr(VacancyConnectors, 'hh', None)); assert callable(getattr(VacancyConnectors, 'superjob', None)); assert callable(getattr(VacancyConnectors, 'avito', None)); from connectors import _structured_text; assert _structured_text({'title':'Пятидневная неделя'}) == 'Пятидневная неделя'; from connectors import _parse_hh_rss; rss='<rss><channel><item><title>Бухгалтер по зарплате</title><link>https://hh.ru/vacancy/123</link><description>Вакансия компании: ГБУЗ Городская больница</description></item></channel></rss>'.encode(); assert _parse_hh_rss(rss)[0]['employer'] == 'ГБУЗ Городская больница'; from connectors import _hh_find_value, _hh_search_item_to_vacancy; assert _hh_find_value({'vacancy':{'descriptionHtml':'<p>Полное описание</p>'}}, ('descriptionText','descriptionHtml')) == '<p>Полное описание</p>'; hh_item=_hh_search_item_to_vacancy({'vacancyId':'124','title':'Бухгалтер по зарплате','descriptionText':'Полное описание из HTML state','links':{'desktop':'https://hh.ru/vacancy/124'}}, 'Сочи'); assert hh_item['description'] == 'Полное описание из HTML state'; from types import SimpleNamespace; from main import refresh_existing_vacancy; job=SimpleNamespace(title='Бухгалтер по зарплате', employer='Работодатель', city='Сочи', description='Коротко', schedule='', experience='', salary_min=None, salary_max=None, currency=None, salary_type='unknown', published_at='', url='', score=0, score_reasons='', net_min_estimate=None, bucket='review', review_reason='', cover_letter='Сохранённое письмо', user_status='saved', last_seen=None); refresh_existing_vacancy(job, {'title':'Бухгалтер по зарплате','employer':'Работодатель','city':'Сочи','description':'Расчёт заработной платы, отпускных и больничных, табели, 1С:БГУ, Excel','salary_min':80000,'salary_max':100000,'currency':'RUB','salary_type':'net','schedule':'5/2','experience':'От 3 лет','url':'https://example.invalid/job'}, 60000); assert job.bucket == 'qualified'; assert job.description.startswith('Расчёт'); assert job.user_status == 'saved'; assert job.cover_letter == 'Сохранённое письмо'; import asyncio, main as appmain; _active=[0,0]; _lock_test='async def _fake_search(notify=True):\n _active[0]+=1\n _active[1]=max(_active[1],_active[0])\n await asyncio.sleep(0.01)\n _active[0]-=1\n return {}\nasync def _check_search_lock():\n old=appmain._run_search_unlocked\n appmain._run_search_unlocked=_fake_search\n try:\n  await asyncio.gather(appmain.run_search(), appmain.run_search())\n  assert _active[1] == 1\n finally:\n  appmain._run_search_unlocked=old'; exec(_lock_test); asyncio.run(_check_search_lock())"
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
