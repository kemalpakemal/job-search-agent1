FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY source.zip /tmp/source.zip
RUN python -c "import zipfile; zipfile.ZipFile('/tmp/source.zip').extractall('/app')" \
    && pip install --no-cache-dir -r /app/requirements.txt \
    && mkdir -p /data
COPY scoring.py /app/scoring.py
COPY connectors.py /app/connectors.py
COPY main.py /app/main.py
COPY telegram_bot.py /app/telegram_bot.py
RUN python -m py_compile /app/main.py /app/connectors.py /app/scoring.py /app/telegram_bot.py \
    && python -c "from scoring import score_vacancy, is_profile_relevant, has_training_offer, has_experience_conflict; exact={'title':'Бухгалтер по зарплате','city':'Сочи'}; unrelated={'title':'Бухгалтер-эксперт','city':'Сочи','description':'Расчёт себестоимости, дебиторская задолженность, акты сверки'}; training={'title':'Ведущий бухгалтер по расчёту заработной платы','city':'Сочи','description':'Расчёт зарплаты, больничные, отпускные. Обучим сами, опыт не требуется'}; assert score_vacancy(exact)[0] >= 80; assert not is_profile_relevant(unrelated); assert is_profile_relevant(training); assert has_training_offer(training['description']); assert not has_experience_conflict('От 5 лет опыта, но обучим сами'); from connectors import VacancyConnectors; assert callable(getattr(VacancyConnectors, 'hh', None)); assert callable(getattr(VacancyConnectors, 'superjob', None)); assert callable(getattr(VacancyConnectors, 'avito', None)); from connectors import _structured_text; assert _structured_text({'title':'Пятидневная неделя'}) == 'Пятидневная неделя'; from types import SimpleNamespace; from main import refresh_existing_vacancy; job=SimpleNamespace(title='Бухгалтер по зарплате', employer='Работодатель', city='Сочи', description='Коротко', schedule='', experience='', salary_min=None, salary_max=None, currency=None, salary_type='unknown', published_at='', url='', score=0, score_reasons='', net_min_estimate=None, bucket='review', review_reason='', cover_letter='Сохранённое письмо', user_status='saved', last_seen=None); refresh_existing_vacancy(job, {'title':'Бухгалтер по зарплате','employer':'Работодатель','city':'Сочи','description':'Расчёт заработной платы, отпускных и больничных, табели, 1С:БГУ, Excel','salary_min':80000,'salary_max':100000,'currency':'RUB','salary_type':'net','schedule':'5/2','experience':'От 3 лет','url':'https://example.invalid/job'}, 60000); assert job.bucket == 'qualified'; assert job.description.startswith('Расчёт'); assert job.user_status == 'saved'; assert job.cover_letter == 'Сохранённое письмо'; import asyncio, main as appmain; _active=[0,0]; _lock_test='async def _fake_search(notify=True):\n _active[0]+=1\n _active[1]=max(_active[1],_active[0])\n await asyncio.sleep(0.01)\n _active[0]-=1\n return {}\nasync def _check_search_lock():\n old=appmain._run_search_unlocked\n appmain._run_search_unlocked=_fake_search\n try:\n  await asyncio.gather(appmain.run_search(), appmain.run_search())\n  assert _active[1] == 1\n finally:\n  appmain._run_search_unlocked=old'; exec(_lock_test); asyncio.run(_check_search_lock())"
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
